# 이 파일을 .env 로 복사해 채운다. .env 는 gitignore 대상이다.
#
#   cp .env.example .env
#
# 서버 배포 시 docker-compose.yml 이 .env 를 자동으로 읽는다.

# 관리자 화면(/admin.html) 비밀번호. 반드시 바꿀 것.
ADMIN_PASSWORD=

# 자동 수집 주기(분). 0 이면 자동 수집을 끈다.
COLLECT_INTERVAL_MIN=180

# 크롤러 User-Agent 에 넣을 연락처. 상대 사이트 운영자가 문의할 수 있게 한다.
CRAWLER_CONTACT=

# HTTPS 종단(리버스 프록시) 뒤에 둘 때 1 로 설정하면 쿠키에 Secure 를 붙인다.
COOKIE_SECURE=
